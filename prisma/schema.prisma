generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pengguna {
  id             Int           @id @default(autoincrement())
  namaDepan      String
  namaBelakang   String
  NIK            String        @unique
  email          String        @unique
  tanggalLahir   DateTime
  posisi         Posisi
  kataSandi      String
  nomorTelepon   String?
  alamat         String?
  dibuatPada     DateTime      @default(now())
  diperbaruiPada DateTime      @updatedAt
  kehadiran      Kehadiran[]
  profileImage   ProfileImage?

  @@map("pengguna")
}

model Product {
  id        Int        @id @default(autoincrement())
  name      String
  code      String     @unique
  documents Document[]
  pesan     Pesan[]

  @@map("product")
}

model Pesan {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String
  productName String
  message     String
  createdAt   DateTime @default(now())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])

  @@map("pesan")
}

model Document {
  id          Int        @id @default(autoincrement())
  name        String
  type        String
  size        Int
  url         String
  category    String
  createdAt   DateTime   @default(now())
  productId   Int?
  notadinasId Int?
  notadinas   Notadinas? @relation(fields: [notadinasId], references: [id])
  product     Product?   @relation(fields: [productId], references: [id])

  @@map("document")
}

model Notadinas {
  id        Int        @id @default(autoincrement())
  name      String
  code      String     @unique
  documents Document[]

  @@map("notadinas")
}

model ProfileImage {
  id         Int      @id @default(autoincrement())
  name       String
  url        String
  createdAt  DateTime @default(now())
  penggunaId Int      @unique
  pengguna   Pengguna @relation(fields: [penggunaId], references: [id])

  @@map("profileImage")
}

model Sample {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("samples")
}

model Kehadiran {
  id           Int       @id @default(autoincrement())
  penggunaId   Int
  masuk        DateTime?
  keluar       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  latKeluar    Float?
  latMasuk     Float?
  lokasiKeluar String?
  lokasiMasuk  String?
  longKeluar   Float?
  longMasuk    Float?
  pengguna     Pengguna  @relation(fields: [penggunaId], references: [id])

  @@index([createdAt(sort: Desc), penggunaId])
  @@map("kehadiran")
}

model Galeri {
  id          Int      @id @default(autoincrement())
  name        String
  url         String
  description String
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("galeri")
}

enum Posisi {
  STAFF
  LEADER
  ASMAN
  MANAGER
  DIREKTUR_OPERASIONAL
  KOMISARIS
  CEO
}
